{
  "name": "daily-phrase-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --use-system-ca src/local.mjs",
    "dev:ui": "vite --configLoader native --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env --use-system-ca src/local.mjs",
    "build": "vite build --configLoader native && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "batch:poll": "node --use-system-ca scripts/poll-feeds.mjs",
    "crawler": "node --use-system-ca scripts/crawl.mjs",
    "study:batch": "node --use-system-ca scripts/study-batch.mjs",
    "quality": "node scripts/quality.mjs",
    "harness:language": "node scripts/phrase-language-harness.mjs",
    "baseline": "node scripts/baseline.mjs",
    "load": "node scripts/load.mjs",
    "build:api": "node scripts/build.mjs",
    "plan": "terraform -chdir=infra plan -var-file=envs/baseline.tfvars",
    "deploy": "npm run build:api && terraform -chdir=infra apply -var-file=envs/baseline.tfvars",
    "destroy": "terraform -chdir=infra destroy -var-file=envs/baseline.tfvars",
    "outputs": "terraform -chdir=infra output -json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0"
  }
}
